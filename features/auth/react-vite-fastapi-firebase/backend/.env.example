# Copy this file to ".env" in the backend folder. It is loaded automatically on startup.

# Pick ONE way to provide the Firebase service account:
# 1) Path to the downloaded JSON key (absolute is safest; relative is resolved from where you start uvicorn)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# 2) Or the JSON itself as a single line (handy on Render/Railway/etc.)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", ...}
# 3) Cloud Run / GCP with default credentials: set only the project id
# FIREBASE_PROJECT_ID=your-project-id

# Used by dev_reset_link.py to build the link to your frontend
FRONTEND_URL=http://localhost:5173

# Demo app only: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Optional: also reject tokens that were revoked (adds a network call per request)
AUTH_CHECK_REVOKED=false

# Development: include the real rejection reason in 401 responses (turn off in production)
AUTH_DEBUG=true

# Tolerance for a slightly wrong system clock (seconds, max 60)
AUTH_CLOCK_SKEW_SECONDS=10
